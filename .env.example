# Copia este archivo como .env.local (en tu computadora) o pega estas variables
# en Vercel → Settings → Environment Variables. Todas son opcionales:
# sin claves de pago la tienda funciona en "modo demostración".

# Dirección pública de tu tienda (para SEO y para volver después de pagar)
NEXT_PUBLIC_SITE_URL=https://fruitsisland.vercel.app

# Stripe (tarjetas, Apple Pay, Google Pay y suscripciones del Club)
# https://dashboard.stripe.com/apikeys  → usa sk_test_... para pruebas y sk_live_... para vender
STRIPE_SECRET_KEY=

# PayPal (compras de una sola vez)
# https://developer.paypal.com/dashboard/applications
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" para pruebas, "live" para cobrar de verdad
PAYPAL_ENV=sandbox
# Código de país de 2 letras para la dirección de envío en PayPal (MX, CO, US, ES…)
PAYPAL_COUNTRY_CODE=US
